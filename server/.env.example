# Copy this file to .env and fill in real values before deploying.
# Never commit your actual .env file.

NODE_ENV=development
PORT=4000

# REQUIRED in production - generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Where the JSON data file is stored (ignored in test env, which is memory-only)
DB_PATH=./data/app.json

# Must match the URL the client is served from
CORS_ORIGIN=http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
